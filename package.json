{
  "name": "jira-dashboard",
  "version": "0.1.8",
  "description": "Full-screen terminal dashboard for Jira: 14-day worklog summary and your open tickets",
  "type": "module",
  "bin": {
    "jdb": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "test": "jest",
    "build": "esbuild src/cli.tsx --bundle --outfile=dist/cli.js --platform=node --format=esm --target=node22 --packages=external && chmod +x dist/cli.js",
    "publish-check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run publish-check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged"
  },
  "keywords": [
    "jira",
    "cli",
    "tui",
    "ink",
    "dashboard",
    "worklog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rubyroidas/jira-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Rubyroidas/jira-dashboard/issues"
  },
  "homepage": "https://github.com/Rubyroidas/jira-dashboard#readme",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jest": "^30.5.2",
    "lint-staged": "^15.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0"
  }
}
